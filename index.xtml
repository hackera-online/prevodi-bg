'Можете да качите снимка или PDF (JPG, PNG, PDF) през формата за запитване или да пишете на office.prevodibg@gmail.com. Служител ще се свърже с Вас, за да потвърди цена и срок.',
'Да, предлагаме експресно изпълнение на преводи и легализация. Точният срок и цената зависят от документа, затова служител ще ги потвърди след като види материала. Желаете ли да Ви свържа с екипа?'];
const demo=[
['v','Здравейте, трябва ми диплома за университет в чужбина.'],
['a',WEL+'\nРазбирам. На какъв език е нужен преводът?'],
['v','На английски. И май трябва апостил.'],
['a','Правилно. За диплома апостилът се издава от НАЦИД. Преводът се прави от преводач, регистриран в МВнР, и може да се заверява нотариално, ако институцията го изисква.'],
['v','Мога ли да Ви пратя снимка на дипломата?'],
['a','Да, подходящи са JPG, PNG и PDF. Качете файла във формата за запитване или го пратете на имейла на агенцията. Преди това ме питайте всичко, което Ви е неясно.'],
['v','Имам срок до края на седмицата.'],
['a','Агенцията предлага експресно изпълнение. Точната цена и срок ще потвърди служител, след като види документа. Да запиша заявката Ви и да Ви потърсят?'],
['v','Да, моля.'],
['a','Готово, записах заявка за превод и апостил на диплома, BG → EN, експресно. Служител ще се свърже с Вас при първа възможност.']];
const DOCS={
edu:{tab:'Образование',name:'образователен документ',title:'Образователни документи',text:'Документи, нужни за кандидатстване, работа или признаване на квалификация в чужбина.',items:['Дипломи','Приложения към диплома','Академични справки','Свидетелства'],auth:'НАЦИД',note:'Апостилът за образователни документи обикновено се издава от НАЦИД.'},
law:{tab:'Правни и съдебни',name:'правен или съдебен документ',title:'Правни и съдебни документи',text:'Документи за съд, нотариус и официални процедури в България и чужбина.',items:['Съдебни решения','Пълномощни','Нотариални актове','Договори'],auth:'Министерство на правосъдието',note:'Апостилът за правни документи се издава от Министерството на правосъдието.'},
civ:{tab:'Общински',name:'общински документ',title:'Общински документи и удостоверения',text:'Актове и удостоверения, издадени от общината, за брак, раждане, гражданство и други процедури.',items:['Удостоверения за раждане','Удостоверения за брак','Семейно положение','Актове за гражданско състояние'],auth:'Община',note:'За общински документи апостилът се издава в съответната община.'},
med:{tab:'Медицински',name:'медицински документ',title:'Медицински документи',text:'Документи за лечение, застраховки и медицински процедури в чужбина.',items:['Епикризи','Изследвания','Медицински удостоверения','Рецепти и заключения'],auth:'Според документа',note:'Нужната заверка зависи от документа и институцията, която го изисква.'},
biz:{tab:'Бизнес',name:'фирмен документ',title:'Фирмени и корпоративни документи',text:'Документи за регистрация, договори и корпоративно съдържание за международна работа.',items:['Фирмени документи','Устави','Търговски договори','Корпоративно съдържание'],auth:'МВнР или друг орган',note:'Органът зависи от вида на документа и държавата, пред която се представя.'}};
function el(c,t){const e=document.createElement('div');e.className=c;if(t)e.textContent=t;return e}
function bub(b,w,t){b.appendChild(el('bub '+w,t));b.scrollTop=b.scrollHeight}
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
/* tabs */
const tabs=document.getElementById('tabs'),panels=document.getElementById('panels');
Object.keys(DOCS).forEach((k,i)=>{const d=DOCS[k];
const b=document.createElement('button');b.type='button';b.className='tab';b.id='t-'+k;b.setAttribute('role','tab');b.setAttribute('aria-selected',i===0);b.setAttribute('aria-controls','p-'+k);b.textContent=d.tab;tabs.appendChild(b);
const p=document.createElement('div');p.className='panel'+(i===0?' on':'');p.id='p-'+k;p.setAttribute('role','tabpanel');p.setAttribute('aria-labelledby','t-'+k);
const l=document.createElement('div');const h=document.createElement('h3');h.textContent=d.title;const pp=document.createElement('p');pp.textContent=d.text;const ch=el('chips');d.items.forEach(x=>{const s=document.createElement('span');s.textContent=x;ch.appendChild(s)});l.append(h,pp,ch);
const a=el('auth');a.innerHTML='<small>Обичайна институция</small><b></b><span></span>';a.querySelector('b').textContent=d.auth;a.querySelector('span').textContent=d.note;
p.append(l,a);panels.appendChild(p);
b.onclick=()=>{tabs.querySelectorAll('.tab').forEach(x=>x.setAttribute('aria-selected',x===b));panels.querySelectorAll('.panel').forEach(x=>x.classList.toggle('on',x===p))}});
/* widget */
const wb=document.getElementById('wb'),fp=document.getElementById('fp'),fb=document.getElementById('fb');
function wOpts(){const o=el('opts');OPTS.forEach((t,i)=>{const b=document.createElement('button');b.type='button';b.textContent=(i+1)+'. '+t;b.onclick=()=>say(t,ANS[i],o);o.appendChild(b)});wb.appendChild(o);wb.scrollTop=wb.scrollHeight}
function say(q,a,o){wb.querySelectorAll('.opts').forEach(x=>x.remove());if(o)o.remove();bub(wb,'v',q);const ty=el('typing');ty.innerHTML='<i></i><i></i><i></i>';wb.appendChild(ty);wb.scrollTop=wb.scrollHeight;setTimeout(()=>{ty.remove();bub(wb,'a',a);wOpts()},reduced?0:800)}
bub(wb,'a',WEL);wOpts();
fb.onclick=()=>{const o=fp.classList.toggle('open');fb.setAttribute('aria-expanded',o)};
if(innerWidth<700){fp.classList.remove('open');fb.setAttribute('aria-expanded','false')}
/* quick request -> widget */
document.getElementById('qgo').onclick=()=>{
const d=DOCS[document.getElementById('qd').value],f=document.getElementById('qf').value,t=document.getElementById('qt').value,u=document.getElementById('qu').value;
const q='Имам '+d.name+', превод от '+f.toLowerCase()+' на '+t.toLowerCase()+', срок: '+u+'.';
const a='Благодаря. Преводът се прави от преводач, регистриран в МВнР. '+d.note+' Срок: '+u+'. Точната цена и срок потвърждава служител след като види документа. Искате ли да запиша заявката и да Ви потърсят?';
fp.classList.add('open');fb.setAttribute('aria-expanded','true');say(q,a)};
/* demo conversation */
let run=false;
function start(){if(run)return;run=true;const b=document.getElementById('cb'),rp=document.getElementById('rp'),lc=document.getElementById('lc');b.innerHTML='';lc.classList.remove('sh');rp.style.display='none';let i=0;
function step(){if(i>=demo.length){run=false;rp.style.display='inline-flex';setTimeout(()=>lc.classList.add('sh'),250);return}
const m=demo[i];if(reduced){bub(b,m[0],m[1]);i++;step();return}
const t=el('typing');t.innerHTML='<i></i><i></i><i></i>';b.appendChild(t);b.scrollTop=b.scrollHeight;
setTimeout(()=>{t.remove();bub(b,m[0],m[1]);i++;setTimeout(step,m[0]==='a'?700:450)},m[0]==='a'?850:500)}
step()}
document.getElementById('rp').onclick=start;
document.getElementById('cr').onclick=()=>{document.getElementById('chatBox').scrollIntoView({behavior:'smooth',block:'center'});setTimeout(start,600)};
new IntersectionObserver((es,o)=>es.forEach(e=>{if(e.isIntersecting){setTimeout(start,500);o.disconnect()}}),{threshold:.4}).observe(document.querySelector('#chatBox .chat'));
</script>
</body>
</html>
